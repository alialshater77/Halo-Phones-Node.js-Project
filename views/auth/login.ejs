<%- include('../includes/head.ejs') %>
    <link rel="stylesheet" href="/css/forms.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>
   <%- include('../includes/navigation.ejs') %>

    <main class="auth-page">
        <section class="auth-copy">
            <p class="eyebrow">Account</p>
            <h1>Welcome back.</h1>
            <p>Sign in to keep a phone in your cart and finish the order.</p>
            <p class="admin-hint">To access full functionality on this project, log in with the admin account.<br>admin@admin.com<br>admin123456</p>
        </section>
        <section>
        <% if (errorMessage) { %>
            <div class="user-message user-message--error"><%= errorMessage %></div>
        <% } %>
        <form class="login-form" action="/login" method="POST">
            <div class="form-control">
                <label for="email">E-Mail</label>
                <input 
                    class="<%= validationErrors.find(e => (e.path || e.param) === 'email') ? 'invalid' : '' %>"
                    type="email" 
                    name="email" 
                    id="email" 
                    placeholder="you@example.com"
                    value="<%= oldInput.email %>"
                    required>
            </div>
            <div class="form-control">
                <label for="password">Password</label>
                <input 
                    class="<%= validationErrors.find(e => (e.path || e.param) === 'password') ? 'invalid' : '' %>"
                    type="password" 
                    name="password" 
                    id="password" 
                    placeholder="At least 5 letters or numbers"
                    value="<%= oldInput.password %>"
                    minlength="5"
                    pattern="[A-Za-z0-9]+"
                    title="Use only letters and numbers, at least 5 characters."
                    required>
            </div>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn" type="submit">Login</button>
        </form>
        <div class="auth-links">
            <a href="/reset">Reset Password</a>
        </div>
        </section>
    </main>
<%- include('../includes/end.ejs') %>